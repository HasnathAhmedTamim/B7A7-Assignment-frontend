# Backend REST API base URL, including the /api/v1 prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Public URL of this frontend (used for metadata and absolute links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show one-click demo logins on the sign-in page (set to "false" to hide them).
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true

# Optional server-only override for the backend URL used by route handlers and server rendering.
# API_BASE_URL=

# Secret used to sign the session cookie. At least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
